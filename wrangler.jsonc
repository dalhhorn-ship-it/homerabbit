{
  // Production Worker. Preview is the `preview` env below (separate Worker, separate data).
  // The database ids are PLACEHOLDERS: create the databases in the Cloudflare dashboard and paste the ids
  // (docs/RUNNING.md, "Data setup"). Ids are not secrets. Production and preview must never share a resource.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homerabbit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homerabbit",
      "database_id": "41174761-74c5-4dc7-a9f1-419d6772bb24",
      "migrations_dir": "migrations"
    }
  ],
  // Photos arrive with HR-3; the bucket is bound now so the setup is done once. Private: no public/r2.dev access.
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "homerabbit-photos" }],
  "env": {
    "preview": {
      "name": "homerabbit-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "homerabbit-preview",
          "database_id": "7120b60c-953e-4005-900c-b7db4c1a7fb6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "homerabbit-photos-preview" }]
    }
  }
}
