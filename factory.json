{
  "$comment": "Single source of project configuration for agents, hooks and scripts. Edit via /choose-path and /retro; humans may edit freely.",
  "template": {
    "name": "danfactory",
    "source_repo": "dalhhorn-ship-it/danfactory",
    "ref": "",
    "decision_tree_version": "1.3.0"
  },
  "packs": {
    "autonomy": true
  },
  "project": {
    "name": "homerabbit",
    "one_liner": "Private mobile/iPad web app for two people to log home chores with photos, rank them, and work through them on a kanban board with progress tracking."
  },
  "phase": "build",
  "paths": {
    "primary": "software-product",
    "secondary": []
  },
  "agents": {
    "roster": [
      "product-manager",
      "software-architect",
      "test-writer",
      "developer",
      "code-writer",
      "test-runner",
      "reviewer",
      "task-completion-validator",
      "ui-comprehensive-tester",
      "karen",
      "deploy-watcher",
      "doc-keeper",
      "bulk-reader"
    ],
    "routing": "docs/operating-model/AGENT-ROUTING.md"
  },
  "commands": {
    "test": "bash scripts/app.sh npx vitest run",
    "test_affected": "bash scripts/app.sh npx vitest run --changed origin/main --passWithNoTests",
    "coverage": "bash scripts/app.sh npx vitest run --coverage",
    "lint": "bash scripts/app.sh npm run lint",
    "build": "bash scripts/app.sh npx vite build",
    "deploy": ""
  },
  "coverage_report": {
    "format": "istanbul",
    "file": "coverage/coverage-summary.json"
  },
  "budgets": {
    "test_seconds": 120,
    "affected_test_seconds": 30,
    "deploy_seconds": 180,
    "min_coverage_pct": 80,
    "max_coverage_drop_pct": 2,
    "large_read_lines": 350,
    "session_weighted_tokens_warn": 750000,
    "context_handoff_tokens": 120000,
    "size": {
      "file_lines_warn": 400,
      "file_lines_max": 700,
      "always_loaded_tokens_max": 2500,
      "agents_max": 20,
      "code_growth_30d_pct_warn": 25,
      "doc_tokens_sections": 1500,
      "doc_tokens_warn": 3000
    }
  },
  "gate": {
    "base_branch": "main",
    "protected": [
      "tests/acceptance/**"
    ],
    "review": "advisory",
    "prd": "advisory",
    "security_ignore": [
      ".factory/tests/**",
      "evals/**"
    ]
  },
  "acceptance": {
    "dir": "tests/acceptance",
    "command": "",
    "reference_command": ""
  },
  "evals": {
    "n": 3,
    "model": "sonnet",
    "budget_usd": 5,
    "regression_threshold": 0.34,
    "max_turns": 30
  },
  "autonomy": {
    "enabled": false,
    "staging_branch": "staging",
    "max_attempts": 3,
    "daily_budget_usd": 5,
    "run_budget_usd": 2,
    "model": "sonnet",
    "review_model": "sonnet",
    "max_turns": 40,
    "max_parallel": 1,
    "schedule_ok": false,
    "learn_threshold": 3
  },
  "dashboard": {
    "github_repo": "dalhhorn-ship-it/homerabbit",
    "changelog_file": "CHANGELOG.md",
    "roadmap_view": "sequence",
    "size_days": {
      "S": 1,
      "M": 3,
      "L": 8
    },
    "wip": 1,
    "prod_envs": [
      "prod",
      "production"
    ],
    "hotspot_commits": 500
  },
  "integrations": {
    "codegraph": false,
    "deploy": {
      "provider": "cloudflare",
      "method": "git",
      "production_branch": "main",
      "product": "workers",
      "project_name": "homerabbit",
      "production_url": "https://homerabbit.dalhhorn.workers.dev",
      "worker_name": "homerabbit",
      "workers_subdomain": "dalhhorn",
      "preview_url_pattern": "https://{alias}-{worker}.{subdomain}.workers.dev"
    },
    "skills": {
      "security-audit": {
        "repo": "https://github.com/cloudflare/security-audit-skill",
        "ref": "c1c8a8c1471069fb0e188eeaff69b8e8db6564a8",
        "path": "skills/security-audit",
        "license": "MIT",
        "model_invocable": false
      },
      "cloudflare-deploy": {
        "repo": "https://github.com/davila7/claude-code-templates",
        "ref": "395f30e0cc4b4061692c2f08b3e0d7e4d35b0aa6",
        "path": "cli-tool/components/skills/development/cloudflare-deploy",
        "license": "Apache-2.0",
        "model_invocable": false
      }
    },
    "dashboard_url": "https://claude.ai/artifact/HMgesW1YdK7H9qGbGdyfnN"
  }
}
