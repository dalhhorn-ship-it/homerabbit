{
  // Production Worker. Preview is the `preview` env below (separate Worker, separate data).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homerabbit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "env": {
    "preview": {
      "name": "homerabbit-preview"
      // HR-1 adds the preview bindings. They must never reuse production resources:
      // "d1_databases": [{ "binding": "DB", "database_name": "homerabbit-preview", "database_id": "REPLACE_ME_PREVIEW_D1_ID" }],
      // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "homerabbit-photos-preview" }]
    }
  }
  // HR-1 adds production bindings (D1 `homerabbit`, R2 `homerabbit-photos`); D1 id placeholder: REPLACE_ME_PROD_D1_ID
}
