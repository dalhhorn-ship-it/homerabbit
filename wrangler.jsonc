{
  // Production Worker. Preview is the `preview` env below (separate Worker, separate data).
  // Database ids are not secrets (docs/RUNNING.md, "Data setup"). Production and preview must never share a resource.
  // No R2 (free plan, no card): photos are stored in D1 (HR-3).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "homerabbit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "homerabbit",
      "database_id": "41174761-74c5-4dc7-a9f1-419d6772bb24",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "preview": {
      "name": "homerabbit-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "homerabbit-preview",
          "database_id": "7120b60c-953e-4005-900c-b7db4c1a7fb6",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
